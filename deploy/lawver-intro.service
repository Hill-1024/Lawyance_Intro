[Unit]
Description=Lawver 介绍页静态服务（同域不同进程：介绍页在 8082，功能页在 8081）
Documentation=https://github.com/Hill-1024/Lawyance_Intro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按部署机实际路径与用户调整
User=lawver
WorkingDirectory=/srv/lawver-intro
ExecStart=/usr/bin/python3 /srv/lawver-intro/server/serve.py --root /srv/lawver-intro/current --port 8082
Restart=always
RestartSec=2
# 介绍页只是静态文件，用不上网络之外的能力
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
