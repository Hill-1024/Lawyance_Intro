---
import DownloadPage from '../components/DownloadPage.vue';
import SiteFooter from '../components/SiteFooter.vue';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchLatestRelease } from '../utils/github';

const releaseInfo = await fetchLatestRelease();
---

<BaseLayout
  title="下载中心 | Lawver"
  description="下载 Lawver 法律 AI 工作台客户端，支持网页版及原生 Android 客户端下载。"
>
  <!-- Rendered to static HTML on purpose: release metadata is resolved at build
       time, so hydrating the page would ship the Vue runtime for nothing. -->
  <DownloadPage releaseInfo={releaseInfo} />
  <SiteFooter />
</BaseLayout>

<script>
  import { setupScrollEffects } from '../utils/scrollEffects';

  setupScrollEffects();
</script>
