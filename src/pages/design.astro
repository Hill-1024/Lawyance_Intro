---
import DesignPage from '../components/DesignPage.vue';
import SiteFooter from '../components/SiteFooter.vue';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="系统架构与产品设计 | Lawver"
  description="Lawver 产品设计与系统架构：深入解构工具调用转发（MCPS）、智能体运行流水线（Plan-and-Solve / OCP）、多角色模拟法庭（FSM）与多路召回记忆系统。"
>
  <!-- Rendered to static HTML on purpose: the page has no state, so hydrating it
       would ship the Vue runtime for a scroll animation alone. -->
  <DesignPage />
  <SiteFooter />
</BaseLayout>

<script>
  import { setupScrollEffects } from '../utils/scrollEffects';
  import { setupAmbientBackground } from '../utils/ambientBackground';

  setupScrollEffects();

  // Same scroll-driven background the home page runs off its trust section: the
  // page darkens as the sandbox band fills the viewport, so the band dissolves
  // into the page instead of being pasted onto it.
  setupAmbientBackground(document.querySelector('#security'));
</script>
